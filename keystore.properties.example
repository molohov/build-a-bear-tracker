# Copy to keystore.properties and fill in values after generating a release keystore.
# Generate with:
#   keytool -genkeypair -v -keystore keystore/release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias release

storeFile=keystore/release.jks
storePassword=your-keystore-password
keyAlias=release
keyPassword=your-key-password
